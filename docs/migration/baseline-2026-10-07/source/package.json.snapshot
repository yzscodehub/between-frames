{
  "name": "between-frames",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "node scripts/verify-browser.mjs",
    "test:learning": "node scripts/verify-learning.mjs",
    "test:gpu": "node scripts/verify-gpu-sampling.mjs",
    "test:rays": "node scripts/verify-rays.mjs",
    "test:ray-labs": "node --import tsx scripts/verify-ray-labs.mjs",
    "test:transport": "node scripts/verify-ray-transport.mjs",
    "test:effects": "node --import tsx scripts/verify-ray-effects.mjs",
    "test:reconstruction": "node --import tsx scripts/verify-ray-reconstruction.mjs",
    "test:ray-lifecycle": "node scripts/verify-ray-lifecycle.mjs",
    "test:ray-query": "node scripts/verify-ray-query.mjs",
    "test:shadow": "node --import tsx scripts/verify-shadow-browser.mjs",
    "test:shadow-gpu": "node --import tsx scripts/verify-shadow-gpu.mjs",
    "test:pbr": "node --import tsx scripts/verify-pbr-browser.mjs",
    "test:pbr-gpu": "node --import tsx scripts/verify-pbr-gpu.mjs",
    "test:ssr": "node --import tsx scripts/verify-ssr-browser.mjs",
    "test:ssr-gpu": "node --import tsx scripts/verify-ssr-gpu.mjs",
    "test:taa": "node --import tsx scripts/verify-taa-browser.mjs",
    "test:taa-gpu": "node --import tsx scripts/verify-taa-gpu.mjs",
    "test:study-reading": "node scripts/verify-study-content.mjs",
    "test:navigation": "node scripts/verify-navigation.mjs",
    "test:reading-samples": "node scripts/verify-reading-samples.mjs",
    "capture:reading": "node scripts/capture-reading-previews.mjs",
    "test:continuation-guides": "node scripts/verify-continuation-guides.mjs",
    "capture:continuation": "node --import tsx scripts/capture-continuation-previews.mjs",
    "test:lighting": "node scripts/verify-lighting-browser.mjs",
    "test:lighting-reading": "node --import tsx scripts/verify-lighting-reading.mjs",
    "capture:lighting": "node scripts/capture-lighting-previews.mjs"
  },
  "dependencies": {
    "astro": "5.13.2",
    "@astrojs/react": "4.3.0",
    "@astrojs/mdx": "4.3.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "0.179.1",
    "katex": "0.16.22"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.4",
    "typescript": "5.9.2",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.179.0",
    "@types/katex": "0.16.7",
    "tsx": "4.20.5",
    "@playwright/test": "1.55.0"
  },
  "packageManager": "pnpm@11.19.0"
}
