---
import type {TopicId} from '../../lib/content/catalog';
interface Props {topic:TopicId;id?:string}
const {topic,id='art-'+topic}=Astro.props;
---
<svg class="topic-art" viewBox="0 0 420 230" fill="none" aria-hidden="true">
<defs><linearGradient id={id+'-shade'} x1="130" y1="50" x2="290" y2="190" gradientUnits="userSpaceOnUse"><stop stop-color="currentColor" stop-opacity=".08"/><stop offset="1" stop-color="currentColor" stop-opacity=".55"/></linearGradient></defs>
{topic==='visibility'&&<><path d="M35 175 206 104 391 175 218 223Z" fill="currentColor" opacity=".06"/><ellipse cx="229" cy="174" rx="81" ry="16" fill="currentColor" opacity=".16"/><circle cx="207" cy="115" r="60" fill={'url(#'+id+'-shade)'} stroke="currentColor" stroke-width="1.2"/><ellipse cx="207" cy="115" rx="21" ry="60" stroke="currentColor" opacity=".35"/><ellipse cx="207" cy="115" rx="60" ry="20" stroke="currentColor" opacity=".35"/><path d="m90 32 72 55m-62-65 109 32m-122-7 61 81M207 175v-92" stroke="currentColor" stroke-dasharray="4 5" opacity=".65"/><circle cx="88" cy="30" r="11" fill="#c99442"/><circle cx="207" cy="175" r="4" fill="currentColor"/></>}
{topic==='materials'&&<><path d="M35 174H390" stroke="currentColor" opacity=".2"/>{[95,210,325].map((x,i)=><g><ellipse cx={x} cy="176" rx="45" ry="10" fill="currentColor" opacity=".10"/><circle cx={x} cy="124" r="48" fill={'url(#'+id+'-shade)'} stroke="currentColor" opacity={1-i*.2}/><circle cx={x-17} cy="102" r={4+i*7} fill="white" opacity={.9-i*.25}/></g>)}<path d="M48 203h320" stroke="currentColor" stroke-dasharray="2 7"/></>}
{topic==='transport'&&<><path d="M45 153 248 96 384 147 185 218Z" fill="currentColor" opacity=".08"/><path d="m74 42 119 124L321 41" stroke="currentColor" stroke-width="2"/><path d="m193 166 58 45" stroke="currentColor" stroke-dasharray="4 5" opacity=".6"/><path d="m193 166 9-65" stroke="currentColor" opacity=".45"/><circle cx="193" cy="166" r="5" fill="currentColor"/><path d="m299 38 20-10 22 12-20 12z m0 0v25l22 14V52m20-12v25l-20 12" fill={'url(#'+id+'-shade)'} stroke="currentColor"/><circle cx="74" cy="42" r="7" stroke="currentColor"/><path d="M80 176h90m66-25h96" stroke="currentColor" opacity=".15"/></>}
{topic==='reconstruction'&&<>{Array.from({length:7},(_,x)=>Array.from({length:4},(_,y)=><rect x={63+x*42} y={35+y*42} width="34" height="34" rx="3" stroke="currentColor" opacity=".16"/>))}<path d="m83 182 42-44 43 10 42-78 42 46 41-56 45 20" stroke="currentColor" stroke-width="2"/><path d="m83 182 42-30 43-10 42-25 42-6 41-27 45-4" stroke="#b98a45" stroke-width="2" stroke-dasharray="5 4"/>{[[83,182],[168,148],[252,116],[338,80]].map(([x,y])=><circle cx={x} cy={y} r="4" fill="currentColor"/>)}</>}
{topic==='geometry'&&<><rect x="53" y="25" width="314" height="181" rx="2" stroke="currentColor" opacity=".5"/><rect x="69" y="42" width="133" height="146" stroke="currentColor" opacity=".35"/><rect x="221" y="42" width="128" height="67" stroke="currentColor" opacity=".35"/><rect x="221" y="125" width="128" height="63" stroke="currentColor" opacity=".35"/><path d="m91 165 35-94 60 71Z m146-72 54-37 40 32Z m4 72 24-30 30 41Z" fill={'url(#'+id+'-shade)'} stroke="currentColor"/><path d="M19 197 392 54" stroke="#b98a45" stroke-width="2"/><circle cx="147" cy="148" r="4" fill="#b98a45"/></>}
{topic==='media'&&<>{[0,1,2,3,4].map(i=><path d={`M40 ${76+i*24} Q128 ${28+i*24} 210 ${76+i*24} T385 ${76+i*24}`} stroke="currentColor" opacity={.15+i*.13} stroke-width="1.5"/>)}<circle cx="303" cy="55" r="25" fill={'url(#'+id+'-shade)'}/></>}
</svg>
