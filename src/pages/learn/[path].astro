---
import Layout from '../../layouts/Layout.astro';
import {learningPaths,resource,articles,articleLabHref,getTopic,topicHref} from '../../lib/content/catalog';
export function getStaticPaths(){return learningPaths.map(path=>({params:{path:path.id},props:{path}}));}
const {path}=Astro.props;
---
<Layout title={path.name} description={path.description}><div class="catalog-shell"><div class="catalog-breadcrumb"><a href="/learn/">学习路线</a><span>/</span><span>{path.name}</span></div><header class="catalog-page-head"><span class="catalog-kicker">PATH {path.number} / {path.steps.length} STOPS</span><h1>{path.name}</h1><p>{path.description}</p><div class="path-audience"><strong>适合谁</strong><span>{path.audience}</span></div></header>{path.id==='first-frame'&&<aside class="catalog-planned"><span class="mono">先主线，再分支</span><p>前四站建立坐标、深度、直接阴影与材质基础。后面三站按兴趣选择：AO 看局部环境可见性，SSR 看反射信息，TAA 看历史样本；不要求全部顺读。</p></aside>}<ol class="path-stops">{path.steps.map((id,index)=>{const item=resource(id),article=articles.find(a=>a.id===id);return <li><span class="path-stop-number mono">{String(index+1).padStart(2,'0')}</span><div><div class="catalog-meta"><span>{item.kind}</span>{path.id==='first-frame'&&index>=4&&<span>可选分支</span>}{article&&<span>{article.level}</span>}</div><h2><a href={item.href}>{item.title} ↗</a></h2><p>{item.description}</p>{article&&<><div class="path-stop-actions"><a href={item.href}>阅读文章 →</a><a href={articleLabHref(article)}>打开对应实验 ↗</a><a href={topicHref(article.topic)}>所属主题：{getTopic(article.topic).name}</a></div>{article.prerequisiteReading.length>0&&<div class="path-reading"><span>按需补充知识</span>{article.prerequisiteReading.map(key=><a href={resource(key).href}>{resource(key).title}</a>)}</div>}</>}</div></li>})}</ol><aside class="catalog-planned"><span class="mono">阅读提示</span><p>路线中的相邻文章是推荐衔接。“按需补充知识”帮助你查缺补漏，不要求已有经验的读者重复阅读。</p><a href="/topics/">切换到主题浏览 →</a></aside></div></Layout>
