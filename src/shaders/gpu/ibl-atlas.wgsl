@group(0) @binding(1) var atlas:texture_storage_2d<rgba16float,write>;
@compute @workgroup_size(8,8) fn main(@builtin(global_invocation_id) id:vec3u){if(id.x>=448u||id.y>=32u){return;}let level=id.x/64u;let x=(f32(id.x%64u)+.5)/64;let p=(x-.5)*2*PI;let t=(f32(id.y)+.5)/32*PI;let n=vec3f(cos(p)*sin(t),cos(t),sin(p)*sin(t));var sum=vec3f(0);var w=0.;for(var i=0u;i<256u;i++){if(level==6u){sum+=env(cosineSample(i,n));w+=1;}else{let h=halfSample(i,.2+f32(level)*.16,n);let l=reflect(-n,h);let nl=max(0.,dot(n,l));sum+=env(l)*nl;w+=nl;}}textureStore(atlas,vec2i(id.xy),vec4f(sum/max(w,.00001),1));}
